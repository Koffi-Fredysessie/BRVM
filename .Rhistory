#'
#' @return
#' @export
#'
#' @examples
#' library(stringr)
#' library(jsonlite)
#' library(lubridate)
#' library(stringi)
#' BRVM_ticker_dividende_info("snts")
#' BRVM_ticker_dividende_info("bicc")
#' BRVM_ticker_dividende_info("etit")
BRVM_ticker_dividende_info <- function(ticker) {
# Vérifier si le paramètre ticker est une chaîne de caractères unique
if (!is.character(ticker)) {
# stop(paste0("ticker must be a character"))
stop(paste0('ticker', " must be character") )
}
if (length(ticker) != 1) {
stop("Only one ticker is allowed")
}
# Convertir le ticker en majuscules
ticker <- toupper(ticker)
all_tickers <- c(
"ABJC", "BICC", "BNBC", "BOAB", "BOABF", "BOAC", "BOAM", "BOAN", "BOAS",
"CABC", "CBIBF", "CFAC", "CIEC", "ECOC", "ETIT", "FTSC", "NEIC", "NSBC",
"NTLC", "ONTBF", "ORGT", "ORAC", "PALC", "PRSC", "SAFC", "SCRC", "SDCC",
"SDSC", "SEMC", "SGBC", "SHEC", "SIBC", "SICC", "SIVC", "SLBC", "SMBC",
"SNTS", "SOGC", "SPHC", "STAC", "STBC", "SVOC", "TTLC", "TTLS", "UNLC",
"UNXC"
# , "TTRC"
)
if (ticker %in% all_tickers) {
url <- paste0("https://www.richbourse.com/common/mouvements/index/", ticker)
} else {
return("Make sure you entered the right ticker")
}
page <- httr::GET(url)
page <- httr::content(page, as = "text", encoding = "UTF-8")
page <- unlist(strsplit(page, split = "\n"))
if (url == "https://www.richbourse.com/common/mouvements/index/SVOC") {
cat("\033[32mPour la société Movis Côte d'Ivoire, aucune information sur les dividendes et ses états financiers n'est diponible.\033[0m\n")
return("")
} else {
# # Utiliser un code plus concis pour eviter des erreurs
# # Je veux détecter le numero de l'indentifiant ayant le plus grand nombre élément
# detect_max = NULL
# for (i in 1:length(page)) {
#   the_length = length(unlist(strsplit(page[[i]], split = ":")))
#   detect_max = cbind(detect_max, the_length)
#
# }
#
# # Sauvegarder le maximum
# sav_max = max(detect_max)
#
# # Le max est 46 ce qui correspond à la ligne 422
# vect_flags_idx = NULL
# for (i in 1:length(page)){
#   if (length(unlist(strsplit(page[[i]], split = ":"))) == sav_max) {
#     if ((unlist(strsplit(page[[i]], split = ":")))[[1]] == "                    data") {
#       pre2_data1 <- unlist(strsplit(page[[i - 2]], split = ":"))[[2]]
#       if (stri_detect_coll(pre2_data1,
#                            " 'flags',")) { #Permet de détecter le flags
#         # flags_idx = i
#         vect_flags_idx <- c(vect_flags_idx, i)
#         # print(i)
#
#       }
#
#     }
#   }
# }
# Utiliser un code plus concis pour eviter des erreurs
# Je veux détecter le numero de l'indentifiant ayant le flags dans son text
# Assurez-vous que i est dans la plage valide des indices de page
vect_flags_idx = NULL
for (i in 1:length(page)) {
if (i > length(page)) {
break  # Sortir de la boucle si i dépasse la taille de page
}
pre2_data1 <- unlist(strsplit(page[[i]], split = ":"))
# Vérifiez que pre2_data1 contient au moins deux éléments
if (length(pre2_data1) >= 2) {
value <- pre2_data1[[2]]
if (stri_detect_coll(value, " 'flags',")) {
# La condition est vraie pour la valeur de i
# cat("La condition est vraie pour i =", i, "\n")
vect_flags_idx = i
break
}
}
}
}
# Si vect_flags_idx == 1 alors c'est bon, on peut donc débuter le code pour obtenir le json
if (length(vect_flags_idx)== 1) {
# Mettre en oeuvre les codes pour obtenir les infos sur les dividendes, états financiers, etc...
# Extract the JSON-like data from the page content
data_start <- regexpr("data: \\[\\{", page[[vect_flags_idx+2]])
data_end <- regexpr("\\}\\],", page[[vect_flags_idx+2]])
json_data <- substr(page[[vect_flags_idx+2]], data_start, data_end + attr(data_end, "match.length") - 1)
# Remove unnecessary characters at the beginning and end
json_data <- substr(json_data, 8, nchar(json_data) - 2)
# Replace any escaped backslashes with single backslashes
json_data <- gsub("\\\\", "\\", json_data)
# Remove unnecessary information from the JSON data
json_data_cleaned <- gsub("\"width\":16,\"style\":{\"color\":\"[a-zA-Z]+\"}", "", json_data, perl = TRUE)
json_data_cleaned <- gsub("\"shape\":\"circlepin\",\"fillColor\":\"[a-zA-Z]+\",\"width\":16,\"style\":{\"color\":\"white\"}", "", json_data_cleaned, perl = TRUE)
# Add square brackets to make it a valid JSON array
json_data_cleaned <- paste("[", json_data_cleaned, "]", sep = "")
# Split the cleaned JSON data into individual components
# Jusqu'ici tout va bien
# Si je dois reprendre le code, débuter ici
components <- unlist(strsplit(json_data_cleaned, "\\},\\{"))
# Function to remove specific elements from a component
remove_elements <- function(component) {
# Define elements to remove
elements_to_remove <- c(#"</span></b><br/><br/>\",\"shape\":\"circlepin\",\"fillColor\":\"#000\",",
"</b><br/><br/>\",\"shape\":\"circlepin\",\"fillColor\":\"#000\",",
"<b>",
"</b>",
# "\",
"<br/>",
"<span style=\"color:green",
"<span style=\"color:red",
",\"shape\":\"squarepin\"",
",\"shape\":\"circlepin\",\"fillColor\":\"green\",",
",\"shape\":\"circlepin\",\"fillColor\":\"#000\",",
",\"shape\":\"circlepin\",\"fillColor\":\"red\",")
# Remove the elements
for (element in elements_to_remove) {
component <- gsub(element, "", component)
}
return(component)
}
# Apply the remove_elements function to each component
cleaned_components <- lapply(components, remove_elements)
}
# Verifier pour chaque [i] si la condition suivante est respectée ou non
# substr(cleaned_components[i], nchar(cleaned_components[i]) - 1, nchar(cleaned_components[i])) %in% c("n\"",'>"',"}]")
for (i in 1:length(cleaned_components)) {
if (!substr(cleaned_components[i],
nchar(cleaned_components[i]) - 1,
nchar(cleaned_components[i])) %in% c("n\"",'>"',"}]")) {
cleaned_components[i] = paste0(cleaned_components[i], '"')
}
# Verifier si tous les débuts sont aussi bons
if (i == 1) {
if (substr(cleaned_components[i], 1, 2) != "[{") {
print(paste0("La data cleaned_components ", i, " doit être vu de prêt"))
print(cleaned_components[i])
}
} else{
if (!substr(cleaned_components[i], 1, 2) != "{\"") {
print(paste0("La data cleaned_components ", i, " doit être vu de prêt"))
print(cleaned_components[i])
}
}
}
check <- sapply(cleaned_components, function(component) {
substr(component, nchar(component) - 1, nchar(component)) %in% c("n\"",'>"',"}]")
})
# # Vérifier si tous les éléments sont TRUE
# all_elements_end_with_quotes <- all(check)
# Afficher le résultat
# if (all_elements_end_with_quotes) {
#   cat("Tous les éléments se terminent par deux guillemets doubles.\n")
# } else {
#   cat("Certains éléments ne se terminent pas par deux guillemets doubles.\n")
# }
# Verifier si tout est OK ou non
if (!all(check)) {
# On doit alors revoir ce qu'il faut corriger avant de continuer
# Mettre des code pour étudier à nouveau les components_cleaned
} else {
# Tout est OK on peut continuer
# Mettre ici le reste des codes
# Add back the curly braces for each cleaned component
# To create a good JSOn format data
# Je sauvegarde pour une utlisation ultérieure
# cleaned_components1 = cleaned_components
for (i in 1:length(cleaned_components)) {
if(i == 1 ){
cleaned_components[[i]] <- paste0(cleaned_components[[i]], "}")
} else if( i == length(cleaned_components)) {
cleaned_components[[i]] <- paste0("{", cleaned_components[[i]])
} else {
cleaned_components[[i]] <- paste0("{", cleaned_components[[i]], "}")
}
}
# Remplacer "u00e9" et "u00e8" par "é" et "è" respectivement
cleaned_components <- gsub("u00e9", "é", cleaned_components) # Formater les é
cleaned_components <- gsub("u00e8", "è", cleaned_components) # Formater les è
# Retravailler la partie là ultérieurement pour l'inclure au niveau de la colonne titre
# cleaned_components <- gsub('\">Information non confirmée par la BRVM</span>', "", cleaned_components)
# Remplacer ça par
# Là je pour simplement l'ajuster après
cleaned_components <- gsub('\">Information non confirmée par la BRVM</span>', " Information non confirmée par la BRVM", cleaned_components)
# Parse the cleaned JSON data
# Je commence par mieux comprendre comment transformer le fichier en JSON ici
# parsed_data <- fromJSON(json_data_cleaned)
# parsed_data <- fromJSON(cleaned_components[[1]])
# Terminer le formatage des données
for (elem in 1:length(cleaned_components)) {
cleaned_components[[elem]] = gsub("</span>P", " & P",cleaned_components[[elem]])
cleaned_components[[elem]] = gsub('\">B', " : B",cleaned_components[[elem]])
# Pour la perte, revoir le code après
cleaned_components[[elem]] = gsub('\">P', " : P",cleaned_components[[elem]])
cleaned_components[[elem]] = gsub("</span>", "",cleaned_components[[elem]])
cleaned_components[[elem]] = gsub('2023Publication', "2023 Publication",cleaned_components[[elem]])
cleaned_components[[elem]] = gsub('2022Publication', "2022 Publication",cleaned_components[[elem]])
cleaned_components[[elem]] = gsub('2021Publication', "2021 Publication",cleaned_components[[elem]])
cleaned_components[[elem]] = gsub('2020Publication', "2020 Publication",cleaned_components[[elem]])
}
# Nouveau codes ajoutés
# Nettoyer les éléments en enlevant les crochets [ et ]
cleaned_components <- lapply(cleaned_components, function(component) {
component <- gsub("^\\[|\\]$", "", component)
return(component)
})
# Fusionner les éléments nettoyés en une seule chaîne JSON valide
sav_cleaned_components <- paste0("[", paste(cleaned_components, collapse = ","), "]")
# Puisque cleaned_components[1] ressemble à "[{\"x\":...\"}"
# et cleaned_components[2] jusqu'à l'avant dernier cleaned_components ressemblent à {\"x\":...\"}"
# et le dernier element cleaned_components ressemble à {\"x\":...}]"
# Mettre tous les éléments ensemble pour obtenir un bon fichier JSON
# sav_cleaned_components = paste0(cleaned_components, collapse = ",")
# A ce niveau je vais tester si tout est OK
# Pour tout élément i  allant de 1 à length(sav_cleaned_components)
# Je verifie si tout fromJSON(sav_cleaned_components[i]) ne retourne aucune erreur
# ie si le début et la fin sont bons
if (startsWith(sav_cleaned_components, '[{\"') && endsWith(sav_cleaned_components, '\"}]')) {
json_final_dt = fromJSON(sav_cleaned_components)
} else if (!endsWith(sav_cleaned_components, '\"}]')) {
sav_cleaned_components = gsub("}]", '"}]',sav_cleaned_components)
json_final_dt = fromJSON(sav_cleaned_components)
}
names(json_final_dt) = c("Date", "Titre", "Information et montant")
# names(json_final_dt) = c("Date", "Titre", "Texte", "Montant")
# json_final_dt$Date <- as.numeric(json_final_dt$Date)
## Turn date in format "%Y-%m-%d"
json_final_dt$Date <- as.Date.POSIXct((as.numeric(json_final_dt$Date) + 0.1) / 1000)
# Chercher à obtenir les valeurs dans la colonnes et exclure les alphabets, é, è, /, et &
for (vl in 1:nrow(json_final_dt) ) {
text <- json_final_dt[vl, 3]
# Vérifier si "publication" apparaît deux fois et bénéfice ou perte apparaissent qu'une seule fois
publication_count <- str_count(tolower(text), "publication")
ben_or_perte_count <- str_count(tolower(text), ": bénéfice|: perte")
if (publication_count == 2 && ben_or_perte_count == 1) {
# cat("Le mot 'publication' apparaît deux fois plus que la nomale dans le texte.\n")
# cat("Plus que le mot bénéfice ou perte. DOnc anomalie\n")
phrases <- str_split(text, "(?=Publication)", simplify = TRUE)
# Filtrer les phrases non vides
phrases <- phrases[phrases != ""]
# rvm_phrase = NULL
for (i in 1:length(phrases)) {
if(str_count(tolower(phrases[i]), ": perte|: bénéfice")==0){
# if(!stri_detect_coll(tolower(phrases[i]), ": bénéfice|: perte")){
# rvm_phrase = c(rvm_phrase, i)
phrases[i] = ""
}
# json_final_dt[vl, 3] = phrases[-rvm_phrase]
json_final_dt[vl, 3] = phrases[phrases != ""]
}
rm(phrases)
} else{
json_final_dt[vl, 3] <- json_final_dt[vl, 3]
}
# Ancien code début
# if (json_final_dt[vl, 3] == "Publication des états financiers - 1er Trimestre 2023 Publication des états financiers - Année 2022 : Bénéfice de 153 483 000 FCFA") {
#   json_final_dt[vl, 3] = "Publication des états financiers - Année 2022 : Bénéfice de 153 483 000 FCFA"
#
# } else if(json_final_dt[vl, 3] == "Publication des états financiers - 1er Trimestre 2023 Publication des états financiers - Année 2022 : Bénéfice de 8 475 035 000 FCFA"){
#   json_final_dt[vl, 3] = "Publication des états financiers - Année 2022 : Bénéfice de 8 475 035 000 FCFA"
# }
# Fin ancien code
}
json_final_dt1 = json_final_dt
json_final_dt1[, 3] <- gsub("[a-zA-Zéè/&']", "", json_final_dt1[, 3])
# Pour la colonne 2 ie json_final_dt1[,2] créer la logique suivante :
# Si ça vaut "A" remplacer par "Annonce"
# Si ça vaut "D" remplacer par "Détachement"
# Si ça vaut "R" remplacer par "Publication des états financiers"
# Si ça vaut "RS1" remplacer par "Publication des états financiers du premier semestre"
# Si ça vaut "RS2" remplacer par "Publication des états financiers du deuxième semestre"
# Si ça vaut "RT1" remplacer par "Publication des états financiers du premier trimestre"
# Si ça vaut "RT2" remplacer par "Publication des états financiers du deuxième trimestre"
# Si ça vaut "RT3" remplacer par "Publication des états financiers du troisième trimestre"
# Si ça vaut "RT4" remplacer par "Publication des états financiers du quatrième trimestre"
json_final_dt[, 2] <- sapply(json_final_dt[, 2], function(value) {
if (value == "A") {
return("Annonce de paiement d'un dividende")
} else if (value == "D") {
return("Détachement du dividende")
} else if (value == "R") {
return("Publication des états financiers")
} else if (value == "RA") {
return("Publication des états financiers de fin d'année")
} else if (value == "RS1") {
return("Publication des états financiers du premier semestre")
} else if (value == "RS2") {
return("Publication des états financiers du deuxième semestre")
} else if (value == "RT1") {
return("Publication des états financiers du premier trimestre")
} else if (value == "RT2") {
return("Publication des états financiers du deuxième trimestre")
} else if (value == "RT3") {
return("Publication des états financiers du troisième trimestre")
} else if (value == "RT4") {
return("Publication des états financiers du quatrième trimestre")
} else {
return(value)
}
})
json_final_dt1[, 2] = json_final_dt[, 2]
vl_index <- NULL
# Boucle sur les lignes du dataframe
# Bien évidemment, je peux directement appliquer parts[1] et parts[2] si je le veux
# La première partie sera conservée comme telle
# Et on ajoutera un ligne supplémentaire à la dataframe rbind(json_final_dt)
# Cette nouvelle ligne aura les deux premières colonnes identiques
# à celle de parts[1]
# Ou mieux encore créer un nouvelle dataframe et sauvegarder les info
# Après faire simplement un Rbind
# Créer deux dataframes contenant des NA new_json_final_dt1 et new_json_final_dt2
new_json_final_dt1 = as.data.frame(matrix(NA, ncol = 3, nrow = 0))
names(new_json_final_dt1) = names(json_final_dt1)
new_json_final_dt2 = as.data.frame(matrix(NA, ncol = 3, nrow = 1))
names(new_json_final_dt2) = names(json_final_dt1)
for (vl in 1:nrow(json_final_dt1)) {
# if (nchar(json_final_dt1[vl, 3]) < 55) {
if (nchar(json_final_dt1[vl, 3]) < 40) {
if (stri_detect_coll(json_final_dt[vl, 3], " Information non confirmée par la BRVM")) {
json_final_dt[vl, 2] = paste0(json_final_dt[vl, 2], " -", " Information non confirmée par la BRVM")
json_final_dt[vl, 3] = gsub(" Information non confirmée par la BRVM", "",json_final_dt[vl, 3])
}
# Vérifier s'il existe ou non ":"
if (stri_detect_coll(json_final_dt1[vl, 3], ":")) {
# if (stri_detect_coll(json_final_dt1[vl, 3], ":") == TRUE) {
# Garder en mémoire les index de lignes
vl_index <- c(vl_index, vl)
# Diviser la chaîne en deux parties séparées par ":"
parts <- unlist(strsplit(json_final_dt[vl, 3], ":"))
# Verifier qu'il existe exactement deux éléments dans parts
if (length(parts) == 2) {
# Scinder les éléments en deux parties bien établie
new_json_final_dt2[1,1] = json_final_dt[vl,1] # La date
# new_json_final_dt2[1,2] = rev(unlist(strsplit(parts[1], ":")))
if (stri_detect_coll(tolower(rev(unlist(strsplit(parts[2], ":")))), "bénéfice")) {
the_text = " : Bénéfice"
} else if (stri_detect_coll(tolower(rev(unlist(strsplit(parts[2], ":")))), "perte")) {
the_text = " : Perte"
}
new_json_final_dt2[1,2] = paste0(rev(unlist(strsplit(parts[1], ":"))), the_text)  #Le titre
# new_json_final_dt2[1,3] = rev(unlist(strsplit(parts[2], ":")))
new_json_final_dt2[1,3] = as.numeric(gsub("[aA-zZéè ]",
"",
rev(unlist(strsplit(parts[2], ":")))))
new_json_final_dt2$Date = as_date(new_json_final_dt2$Date)
new_json_final_dt1 = rbind(new_json_final_dt1, new_json_final_dt2)
}
} else {
if (!stri_detect_coll(tolower(json_final_dt[vl, 3]), "bénéfice") &&
!stri_detect_coll(tolower(json_final_dt[vl, 3]), "perte") &&
!stri_detect_coll(tolower(json_final_dt[vl, 3]), "annonce") &&
!stri_detect_coll(tolower(json_final_dt[vl, 3]), "détachement")){
# Garder en mémoire les index de lignes
vl_index <- c(vl_index, vl)
new_json_final_dt2[1,1] = json_final_dt[vl,1] # La Date
new_json_final_dt2[1,2] = json_final_dt[vl, 3]
new_json_final_dt2[1,3] = "Détail indisponible" #Nous n'avons pas le montant disponible
new_json_final_dt2$Date = as_date(new_json_final_dt2$Date)
# message(paste0("NB : ", "Le détail sur les états financiers publiés le ",  strftime(as_date(new_json_final_dt2[1,1]), format = "%d-%m-%Y"), " est indisponible"))
cat("\033[32mNB : ", "Le détail sur les états financiers publiés le ", strftime(as.Date(new_json_final_dt2[1, 1]), format = "%d-%m-%Y"), " est indisponible.\033[0m\n")
new_json_final_dt1 = rbind(new_json_final_dt1, new_json_final_dt2)
} else{
# Effacer les espaces et garder uniquement les nombres
json_final_dt1[vl, 3] <- gsub("\\s+", "", json_final_dt1[vl, 3])
}
}
} else {
if (stri_detect_coll(json_final_dt1[vl, 3], ":") == TRUE) {
# Diviser la chaîne en deux parties séparées par "&"
parts <- unlist(strsplit(json_final_dt[vl, 3], "&"))
# Verifier qu'il existe plus d'un élément dans parts
if (length(parts) > 1) {
# Verifier qu'il existe exactement deux éléments dans parts
if (length(parts) >= 2) {
# Garder en mémoire les index de lignes
vl_index <- c(vl_index, vl)
# Scinder les éléments en deux parties bien établie
# p1 = c(rev(unlist(strsplit(parts[1], ":")))[2],
#        rev(unlist(strsplit(parts[1], ":")))[1])
#
# p2 = c(rev(unlist(strsplit(parts[2], ":")))[2],
#        rev(unlist(strsplit(parts[2], ":")))[1])
for (elem in 1:length(parts)) {
# Faire une boucle pour remplir la nouvelle dataframe avec un rbind
new_json_final_dt2[1,1] = json_final_dt[vl,1] # La Date
if (stri_detect_coll(tolower(rev(unlist(strsplit(parts[elem], ":")))[1]), "bénéfice")) {
the_text = " : Bénéfice"
} else if (stri_detect_coll(tolower(rev(unlist(strsplit(parts[elem], ":")))[1]), "perte")) {
the_text = " : Perte"
}
# les deux premiers code renvoient lex expressions contenus dans chaque éléments
# new_json_final_dt2[vl,2] = rev(unlist(strsplit(parts[elem], ":")))[2]
# new_json_final_dt2[vl,3] = rev(unlist(strsplit(parts[elem], ":")))[1]
# Je veux simplement garder les nombres
new_json_final_dt2[1,2] = paste0(rev(unlist(strsplit(parts[elem], ":")))[2], the_text)
new_json_final_dt2[1,3] = as.numeric(gsub("[aA-zZéè ]","",rev(unlist(strsplit(parts[elem], ":")))[1]))
new_json_final_dt2$Date = as_date(new_json_final_dt2$Date)
new_json_final_dt1 = rbind(new_json_final_dt1, new_json_final_dt2)
}
}
} else if (length(parts)==1) {
parts <- unlist(strsplit(json_final_dt[vl, 3], ":"))
if (length(parts) == 2) {
# Garder en mémoire les index de lignes
vl_index <- c(vl_index, vl)
for (elem in 1:length(parts)) {
# Faire une boucle pour remplir la nouvelle dataframe avec un rbind
new_json_final_dt2[1,1] = json_final_dt[vl,1] # La Date
if (stri_detect_coll(tolower(rev(unlist(strsplit(parts[elem], ":")))[1]), "bénéfice")) {
the_text = " : Bénéfice"
} else if (stri_detect_coll(tolower(rev(unlist(strsplit(parts[elem], ":")))[1]), "perte")) {
the_text = " : Perte"
}
# Je veux simplement garder les nombres
new_json_final_dt2[1,2] = paste0(rev(unlist(strsplit(parts[elem], ":")))[2], the_text)
new_json_final_dt2[1,3] = as.numeric(gsub("[aA-zZéè ]","",rev(unlist(strsplit(parts[elem], ":")))[1]))
new_json_final_dt2$Date = as_date(new_json_final_dt2$Date)
new_json_final_dt1 = rbind(new_json_final_dt1, new_json_final_dt2)
}
}
}
}
}
}
if (!is.null(vl_index)) {
json_final_dt[-c(vl_index),3] = json_final_dt1[-c(vl_index),3]
json_final_dt = json_final_dt[-c(vl_index),]
new_json_final_dt1 = na.omit(new_json_final_dt1)
json_final_dt = rbind(json_final_dt, new_json_final_dt1)
names(json_final_dt) = c("Date", "Titre", "Montant (en FCFA)")
json_final_dt = dplyr::arrange(json_final_dt, json_final_dt$Date)
}
}
